    "npm": ">=6.9.0"
  },
  "enact": {
    "theme": "sandstone"
  },
  "eslintConfig": {
    "extends": "enact-proxy"
  },
  "eslintIgnore": [
    "node_modules/*",
    "dist/*"
  ],
  "dependencies": {
    "@enact/core": "^4.8.0",
    "@enact/i18n": "^4.7.8",
    "@enact/sandstone": "^2.8.0",
    "@enact/spotlight": "^4.7.8",
    "@enact/ui": "^4.7.8",
    "@enact/webos": "^4.7.8",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "ilib": "npm:ilib-webos@^14.19.0-webos1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.23.1",
    "web-vitals": "^3.5.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "devDependencies": {
    "@enact/cli": "^6.1.3",
    "eslint-config-enact-proxy": "^1.0.7"
  }
